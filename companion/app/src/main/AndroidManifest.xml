<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="true" />

    <!-- BLE link. Scanning is done by the Companion Device Manager chooser, so no scan permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Companion device: background start/run exemptions and presence callbacks (API 31+). -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Held only during a firmware transfer, and for a few seconds of periodic work in Doze. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Optional features; requested at runtime only when enabled in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 10+: weather by phone location while the app is closed. Asked for separately,
         after an explanation; declining keeps weather working with foreground-only fixes. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Health Connect: write the watch step counts (only when the sync option is on). -->
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Camera remote: asked for the first time the watch opens its Camera app. Saving to
         Pictures needs storage access only before Android 10. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Package visibility (API 30+): needed to resolve the app label of a notification's
         or media session's package; without it every label falls back to the package name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Health Connect provider app (Android 9-13; part of the system from 14). -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_watch"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EpaperWatch">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AppFilterActivity"
            android:exported="false"
            android:label="Notification apps" />

        <!-- Opened by the watch's Camera app, also over the lock screen. Not recreated on
             rotation, so the watch is not told it closed. -->
        <activity
            android:name=".ui.CameraActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="Watch camera"
            android:launchMode="singleTask"
            android:taskAffinity="com.james.epaperwatch.camera"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <activity
            android:name=".ui.FirmwareUpdateActivity"
            android:exported="false"
            android:label="Firmware update" />

        <!-- Health Connect permission rationale (privacy policy). Android 9-13: the Health
             Connect app starts it with ACTION_SHOW_PERMISSIONS_RATIONALE. -->
        <activity
            android:name=".ui.HealthRationaleActivity"
            android:exported="true"
            android:label="Step data">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+: the system starts it from the health permission usage screen. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".WatchLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".WatchNotificationListener"
            android:exported="true"
            android:label="Send notifications to E-Paper Watch"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".WatchCompanionService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            tools:targetApi="s">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
